# Neon PostgreSQL connection string
# Get it from: https://console.neon.tech → your project → Connection Details
DATABASE_URL=postgresql://neondb_owner:YOUR_PASSWORD@YOUR_HOST/neondb?sslmode=require&channel_binding=require

# JWT signing secret — use a long random string (32+ chars)
# Generate one: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=change-this-to-a-long-random-string-at-least-32-chars

# Port (Render sets this automatically — do not override in production)
PORT=3000

# Agora App ID + App Certificate (for /rtc/token)
# Get them from: https://console.agora.io → your project → Config
AGORA_APP_ID=your-agora-app-id
AGORA_APP_CERTIFICATE=your-agora-app-certificate
